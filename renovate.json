{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in the Dockerfiles: the ARG below a renovate comment (wal-g tag, go version)",
      "managerFilePatterns": ["/^images/[^/]+/Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\nARG\\s+[A-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ]
}
